{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "pre": "curl/"
          }
        }
      ],
      "destination": "/api/coffee"
    },
    {
      "source": "/",
      "destination": "/static.html"
    }
  ]
}
